
OutFileStream FLOPsheetStream { filename = "engine_deck.csv"; } 

DataViewer CaseRowViewer Decksheet { 

  caseHeaderBody = ""; 
  caseHeaderVars = {} 
  
  variableList = {  
    "CASE: ????? = Case",
    "Limit_Flag = Limit_Flag",

    // Operating Conditions
    "SPEC_DAY = Day",
    "Amb.MN:         ?.?? = Mach",
    "Amb.alt:        ??????.? = Alt",
    "Amb.dTs:        ??????.??? = Tds",

    // Station Temperatures
    "Amb.Ts:         ??????.??? = Tt1",
    "InEng.Fl_O.Tt:  ??????.??? = Tt2",
    "CmpH.Fl_O.Tt:   ??????.??? = Tt3",
    //"B030.Fl_O.Tt:   ??????.??? = TtB030",
    "BrnPri.Fl_O.Tt: ??????.??? = Tt4",
    "TrbH.Fl_O.Tt:   ???????.??? = Tt5",
    "NozPri.Fl_O.Tt: ??????.??? = Tt9",

    // Station Pressures
    "Amb.Ps:         ??????.??? = Pt1",
    "InEng.Fl_O.Pt:  ??????.??? = Pt2",
    "CmpH.Fl_O.Pt:   ??????.??? = Pt3",
    //"B030.Fl_O.Pt:   ??????.??? = PtB030",
    "BrnPri.Fl_O.Pt: ??????.??? = Pt4",
    "TrbH.Fl_O.Pt:   ???????.??? = Pt5",
    "NozPri.Fl_O.Pt: ??????.??? = Pt9",

    // Engine Performance Metrics
    "Amb.W:          ???.???? = W1",
    "Eng.Fn:         ??????.? = Fn", 
    "Eng.Fg:         ??????.? = Fg",
    "Eng.Fram:       ??????.? = Fr",
    "PercentFn:      ??????.? = PercFn",
    "Eng.WfuelHour:  ??????.? = WFuel",
    "Eng.TSFC:       ??.????? = TSFC",
    "CmpH.Nc:        ??.????E???? = CmpH_Nc",
    "ShH.Nmech:      ??.????E???? = N",
    "ShH.HPX:        ??????.? = HPX"
    };
  
  
  showMarks = FALSE; 
  showHeaders = TRUE; 
  //pageWidth = 124; 
  //pageHeight = 800; 
  
  outStreamHandle = "FLOPsheetStream"; 

} 
